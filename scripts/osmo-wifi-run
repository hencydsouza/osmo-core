#!/bin/bash
# Run an osmo command on the camera Wi-Fi, then return to the previous network.
set -u

usage() {
    printf '%s\n' 'Usage: osmo-wifi-run [--return-to SSID] -- <osmo arguments...>' \
        'Example: osmo-wifi-run --return-to "Home WiFi" -- -v ls' >&2
}

return_to=${OSMO_RETURN_TO:-}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --return-to)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then usage; exit 2; fi
            return_to=$2; shift 2 ;;
        --) shift; break ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done
if [ "$#" -eq 0 ]; then usage; exit 2; fi

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
osmo_bin=${OSMO_BIN:-"$script_dir/../target/debug/osmo"}
if [ ! -x "$osmo_bin" ]; then
    printf 'Cannot find osmo at %s; build with cargo build -p osmo-cli or set OSMO_BIN.\n' "$osmo_bin" >&2
    exit 1
fi

device=$(networksetup -listallhardwareports | awk '
    /^Hardware Port: (Wi-Fi|AirPort)$/ {wifi=1; next}
    wifi && /^Device: / {print $2; exit}
')
if [ -z "$device" ]; then printf '%s\n' 'Could not find the macOS Wi-Fi interface.' >&2; exit 1; fi

current_ssid() {
    local output
    output=$(networksetup -getairportnetwork "$device" 2>/dev/null) || return 1
    case "$output" in
        'Current Wi-Fi Network: '*) printf '%s' "${output#Current Wi-Fi Network: }" ;;
        'Current AirPort Network: '*) printf '%s' "${output#Current AirPort Network: }" ;;
        *) return 1 ;;
    esac
}

if [ -z "$return_to" ]; then
    return_to=$(current_ssid) || return_to=''
fi
if [ -z "$return_to" ] || [ "$return_to" = '<redacted>' ]; then
    printf '%s\n' 'macOS did not report your current Wi-Fi name. Supply it with --return-to "your network name".' >&2
    exit 1
fi

# `pair` wakes the access point and prints its SSID without printing the password.
pair_output=$("$osmo_bin" pair) || exit $?
camera_ssid=''
while IFS= read -r line; do
    case "$line" in 'SSID: '*) camera_ssid=${line#SSID: }; break ;; esac
done <<< "$pair_output"
if [ -z "$camera_ssid" ]; then printf '%s\n' 'The camera did not provide a Wi-Fi name.' >&2; exit 1; fi

join_network() {
    local output status
    output=$(networksetup -setairportnetwork "$device" "$1" 2>&1)
    status=$?
    case "$output" in *'Failed'*|*'failed'*|*'Error'*|*'error'*|*'Could not'*) status=1 ;; esac
    if [ "$status" -ne 0 ]; then
        printf 'Could not join %s. %s\n' "$1" "$output" >&2
        return 1
    fi
}

restore=0
cleanup() {
    local status=$? actual attempt
    trap - EXIT INT TERM
    if [ "$restore" -eq 1 ]; then
        printf 'Reconnecting to %s ...\n' "$return_to" >&2
        if ! join_network "$return_to"; then
            printf '%s\n' 'Reconnect manually using the macOS Wi-Fi menu.' >&2
            [ "$status" -ne 0 ] || status=1
        elif actual=$(current_ssid); then
            for ((attempt=0; attempt<10; attempt++)); do
                [ "$actual" != "$return_to" ] || break
                sleep 1
                actual=$(current_ssid) || { actual=''; break; }
            done
            if [ -z "$actual" ]; then
                printf '%s\n' 'Reconnect requested; macOS did not reveal the current Wi-Fi name to verify it.' >&2
            elif [ "$actual" != "$return_to" ]; then
                printf 'macOS reports a different network: %s. Check the Wi-Fi menu.\n' "$actual" >&2
                [ "$status" -ne 0 ] || status=1
            fi
        else
            printf '%s\n' 'Reconnect requested; macOS did not reveal the current Wi-Fi name to verify it.' >&2
        fi
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ "$return_to" != "$camera_ssid" ]; then
    restore=1
    printf 'Connecting to camera Wi-Fi %s ...\n' "$camera_ssid" >&2
    if ! join_network "$camera_ssid"; then
        printf '%s\n' 'Join the camera Wi-Fi once in macOS so its password is saved, then retry.' >&2
        exit 1
    fi
fi

# Association can finish before DHCP. Wait for an address on the Action 4's camera subnet.
ready=0
for ((attempt=0; attempt<20; attempt++)); do
    addr=$(ipconfig getifaddr "$device" 2>/dev/null) || addr=''
    case "$addr" in 192.168.2.*) ready=1; break ;; esac
    sleep 1
done
if [ "$ready" -ne 1 ]; then
    printf '%s\n' 'The camera network did not acquire a 192.168.2.x address.' >&2
    exit 1
fi
actual=$(current_ssid) || actual=''
if [ -n "$actual" ] && [ "$actual" != "$camera_ssid" ]; then
    printf 'The Mac is connected to %s instead of the camera.\n' "$actual" >&2
    exit 1
fi
"$osmo_bin" "$@"
