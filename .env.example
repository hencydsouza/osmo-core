# Local macOS Wi-Fi settings for `osmo with-wifi`.
# Use single quotes to preserve spaces, $ and # in values.
OSMO_RETURN_TO=''
OSMO_HOME_WIFI_PASSWORD=''

# Livestream destination; it may contain a private stream key.
OSMO_RTMP_URL=''
# Optional: use a different Wi-Fi network for the camera's livestream.
OSMO_RTMP_SSID=''
OSMO_RTMP_WIFI_PASSWORD=''
